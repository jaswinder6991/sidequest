# Never commit the real .env file.
# Cala calls must be made from the server, not browser JavaScript.
CALA_API_KEY=
CALA_API_BASE_URL=

# Keep this server-side: it powers walking routes.
OPENROUTESERVICE_API_KEY=

# SideQuest's voice. Keep both values server-side.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Visual story moments. Keep server-side; never expose in React.
FAL_KEY=
